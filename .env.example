# ==============================================================================
# Linux Command Intent Engine - Environment Configuration Template
# ==============================================================================

# --- Active AI Provider & Model ---
# Options: "groq", "ollama", "openrouter", "gemini", "openai", "offline"
LLM_PROVIDER=groq
AI_MODEL=llama-3.1-8b-instant

# --- Groq Cloud LPU Configuration ---
# Get your free Groq API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# --- Local Ollama Configuration ---
# Default local Ollama endpoint (models: llama3.2:1b, phi4-mini:3.8b)
OLLAMA_BASE_URL=http://localhost:11434

# --- Optional Cloud AI Providers ---
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Server & Sandbox Configuration ---
WEB_HOST=0.0.0.0
WEB_PORT=8000
SANDBOX_API_URL=http://localhost:3000
